{
  "name": "pastelerias-unidas-backend",
  "version": "1.0.0",
  "description": "Backend API para Pastelerías Unidas - Marketplace de repostería artesanal",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "echo 'No build step required for Node.js backend'",
    "test": "jest",
    "test:verbose": "jest --verbose",
    "test:coverage": "jest --coverage",
    "test:rendimiento": "jest --testPathPattern=06.rendimiento --verbose --forceExit",
    "test:mantenimiento": "jest --testPathPattern=05.mantenimiento --verbose --forceExit",
    "test:informe": "jest --testPathPattern=\"(05|06)\\.(mantenimiento|rendimiento)\" --verbose --forceExit",
    "reportes": "powershell -ExecutionPolicy Bypass -File scripts/generar-reportes.ps1",
    "k6:baseline": "k6 run tests/k6/01.rendimiento-baseline.js",
    "k6:carga": "k6 run tests/k6/02.carga-progresiva.js",
    "k6:estres": "k6 run tests/k6/03.estres.js",
    "k6:disponibilidad": "k6 run tests/k6/04.disponibilidad.js",
    "k6:completo": "powershell -ExecutionPolicy Bypass -File scripts/run-k6-completo.ps1"
  },
  "keywords": [
    "pastelerias",
    "marketplace",
    "mern",
    "reposteria"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "google-auth-library": "^10.7.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.0",
    "multer": "^2.1.1",
    "stripe": "^22.3.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.2.2"
  }
}
