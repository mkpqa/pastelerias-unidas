# ============================================================
# PASTELERÍAS UNIDAS — Variables de Entorno (Frontend)
# ============================================================
# Copia este archivo como .env y completa los valores.
# El archivo .env NUNCA debe subirse al repositorio.

# URL del backend (por defecto apunta a localhost en desarrollo)
VITE_API_URL=http://localhost:5000

# Google OAuth — Client ID para el botón "Continuar con Google"
# Obtener en: console.cloud.google.com → Credenciales → ID de cliente OAuth 2.0
# Tipo: Aplicación web
# Orígenes autorizados: http://localhost:5173  y  https://tu-dominio.com
# Si se deja vacío, el botón de Google no se muestra (la app sigue funcionando)
VITE_GOOGLE_CLIENT_ID=
